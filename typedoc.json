{
  "entryPoints": ["./src/index.ts"],
  "gitRevision": "main",
  "sourceLinkTemplate": "https://github.com/sakitam-gis/mercator-proj/blob/{gitRevision}/{path}#L{line}",
  "excludeExternals": true,
  "excludePrivate": true,
  "excludeInternal": true,
  "excludeProtected": true,
  "hideGenerator": true,
  "includeVersion": true,
  "sort": ["source-order"],
  "plugin": ["typedoc-plugin-not-exported"],
  "name": "mercator-proj",
  "out": "./docs",
  "readme": "none",
  "tsconfig": "./tsconfig.docs.json"
}
